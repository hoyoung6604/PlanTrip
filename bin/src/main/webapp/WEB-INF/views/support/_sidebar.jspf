<%@ page contentType="text/html; charset=UTF-8" pageEncoding="UTF-8"%>
<%@ taglib prefix="c" uri="jakarta.tags.core" %>

<aside class="support-side" aria-label="고객센터 메뉴">
  <a class="support-brand" href="${pageContext.request.contextPath}/" aria-label="메인으로">
    <img src="/img/PlanTriplog.png" alt="PlanTrip" />
  </a>

  <!-- 프로필(아바타) 박스 제거: 사용자 요청(B 영역 제거) -->

  <nav class="support-nav">
    <div class="support-nav__group">
    <a class="support-nav__item ${supportActive=='home'?'is-active':''}" href="${pageContext.request.contextPath}/support">
      <span class="support-nav__ico"><svg viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M3 6.5A2.5 2.5 0 0 1 5.5 4H9l2 2h7.5A2.5 2.5 0 0 1 21 8.5v9A2.5 2.5 0 0 1 18.5 20h-13A2.5 2.5 0 0 1 3 17.5v-11Z" stroke="currentColor" stroke-width="1.8" stroke-linejoin="round"/></svg></span>
      <span class="support-nav__txt">나의 문의 내역</span>
    </a>

    <a class="support-nav__item ${supportActive=='faq'?'is-active':''}" href="${pageContext.request.contextPath}/support/faq">
      <span class="support-nav__ico"><svg viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M12 20a8 8 0 1 0 0-16 8 8 0 0 0 0 16Z" stroke="currentColor" stroke-width="1.8"/><path d="M9.5 9a2.5 2.5 0 1 1 4.2 1.8c-.9.8-1.7 1.3-1.7 2.7" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"/><path d="M12 16.8h.01" stroke="currentColor" stroke-width="2.6" stroke-linecap="round"/></svg></span>
      <span class="support-nav__txt">자주 묻는 질문</span>
    </a>

    <a class="support-nav__item ${supportActive=='notice'?'is-active':''}" href="${pageContext.request.contextPath}/support/notice">
      <span class="support-nav__ico"><svg viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M3 11v2a2 2 0 0 0 2 2h1l1.2 4.2A2 2 0 0 0 9.1 21H10" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/><path d="M6 9l11-4v14L6 15V9Z" stroke="currentColor" stroke-width="1.8" stroke-linejoin="round"/><path d="M17 10.5h2a2 2 0 0 1 0 3h-2" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"/></svg></span>
      <span class="support-nav__txt">공지사항</span>
    </a>

    <c:choose>
      <c:when test="${not empty sessionScope.loginMember}">
        <a class="support-nav__item ${supportActive=='qnaNew'?'is-active':''}" href="${pageContext.request.contextPath}/support/qna/new">
          <span class="support-nav__ico"><svg viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M12 20h9" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"/><path d="M4 16.5V20h3.5L19 8.5 15.5 5 4 16.5Z" stroke="currentColor" stroke-width="1.8" stroke-linejoin="round"/><path d="M13.8 6.7 17.3 10.2" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"/></svg></span>
          <span class="support-nav__txt">문의하기</span>
        </a>
      </c:when>
      <c:otherwise>
        <a class="support-nav__item ${supportActive=='qnaNew'?'is-active':''}" href="#" data-auth-open="login" data-auth-redirect="/support/qna/new">
          <span class="support-nav__ico"><svg viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M12 20h9" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"/><path d="M4 16.5V20h3.5L19 8.5 15.5 5 4 16.5Z" stroke="currentColor" stroke-width="1.8" stroke-linejoin="round"/><path d="M13.8 6.7 17.3 10.2" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"/></svg></span>
          <span class="support-nav__txt">문의하기</span>
        </a>
      </c:otherwise>
    </c:choose>
    </div>

    <div class="support-nav__bottom">
      <a class="support-nav__item support-nav__item--back" href="${pageContext.request.contextPath}/"
         onclick="if(history.length>1){ history.back(); return false; }">
      <span class="support-nav__ico"><svg viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M15 18l-6-6 6-6" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round"/><path d="M9 12h12" stroke="currentColor" stroke-width="1.9" stroke-linecap="round"/></svg></span>
      <span class="support-nav__txt">뒤로</span>
      </a>
    </div>
  </nav>
</aside>
