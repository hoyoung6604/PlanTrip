<%@ page contentType="text/html; charset=UTF-8" pageEncoding="UTF-8" %>
<%@ taglib prefix="c" uri="jakarta.tags.core" %>
<%
  String _uri = request.getRequestURI();
  pageContext.setAttribute("_adminUri", _uri);
%>

<aside class="admin-sidenav" aria-label="관리자 메뉴">
  <div class="admin-sidenav__brand">
    <!-- 로고 클릭 시 사용자 메인(index.jsp)로 이동 -->
    <a class="admin-brand" href="${pageContext.request.contextPath}/" aria-label="메인으로">
      <img class="admin-brand__logo" src="${pageContext.request.contextPath}/img/PlanTrip_White.png" alt="PlanTrip" />
    </a>
  </div>

  <nav class="admin-nav">
    <a class="admin-nav__item ${_adminUri.endsWith('/admin') || _adminUri.endsWith('/admin/') ? 'is-active' : ''}" href="${pageContext.request.contextPath}/admin">
      <span class="admin-nav__ico" aria-hidden="true">
        <svg viewBox="0 0 24 24"><path d="M10 20v-6h4v6h5v-8h3L12 3 2 12h3v8z"/></svg>
      </span>
      <span class="admin-nav__txt">대시보드</span>
    </a>

    <details class="admin-nav__group" ${_adminUri.contains('/admin/members') ? 'open' : ''}>
      <summary class="admin-nav__item ${_adminUri.contains('/admin/members') ? 'is-active' : ''}">
        <span class="admin-nav__ico" aria-hidden="true">
          <svg viewBox="0 0 24 24"><path d="M12 12c2.21 0 4-1.79 4-4s-1.79-4-4-4-4 1.79-4 4 1.79 4 4 4zm0 2c-4.42 0-8 2.24-8 5v1h16v-1c0-2.76-3.58-5-8-5z"/></svg>
        </span>
        <span class="admin-nav__txt">회원 관리</span>
        <span class="admin-nav__chev">▾</span>
      </summary>
      <div class="admin-nav__sub">
        <a class="admin-nav__subitem ${_adminUri.endsWith('/admin/members') ? 'is-active' : ''}" href="${pageContext.request.contextPath}/admin/members">회원 관리</a>
      </div>
    </details>

    <a class="admin-nav__item ${_adminUri.contains('/admin/notices') ? 'is-active' : ''}" href="${pageContext.request.contextPath}/admin/notices">
      <span class="admin-nav__ico" aria-hidden="true">
        <svg viewBox="0 0 24 24"><path d="M3 11v2h2v-2H3zm2-6v2h2V5H5zm0 12v2h2v-2H5zm4-7v4h2v-4H9zm0-6v4h2V4H9zm0 12v4h2v-4H9zm4-8v8h2V8h-2zm4 3v2h2v-2h-2z"/></svg>
      </span>
      <span class="admin-nav__txt">공지사항 관리</span>
    </a>

    <a class="admin-nav__item ${_adminUri.contains('/admin/inquiries') ? 'is-active' : ''}" href="${pageContext.request.contextPath}/admin/inquiries">
      <span class="admin-nav__ico" aria-hidden="true">
        <svg viewBox="0 0 24 24"><path d="M21 6h-2v9H7l-4 4V6c0-1.1.9-2 2-2h16c1.1 0 2 .9 2 2z"/></svg>
      </span>
      <span class="admin-nav__txt">문의 관리</span>
      <c:if test="${not empty pendingQnaCount}">
        <span class="admin-badge">${pendingQnaCount}</span>
      </c:if>
    </a>

    <a class="admin-nav__item ${_adminUri.contains('/admin/faqs') ? 'is-active' : ''}" href="${pageContext.request.contextPath}/admin/faqs">
      <span class="admin-nav__ico" aria-hidden="true">
        <svg viewBox="0 0 24 24"><path d="M11 18h2v-2h-2v2zm1-16C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm0 18c-4.41 0-8-3.59-8-8s3.59-8 8-8 8 3.59 8 8-3.59 8-8 8zm0-14c-2.21 0-4 1.79-4 4h2a2 2 0 1 1 2 2c-.83 0-1.5.67-1.5 1.5V15h2v-.5c0-.28.22-.5.5-.5 1.93 0 3.5-1.57 3.5-3.5S13.93 6 12 6z"/></svg>
      </span>
      <span class="admin-nav__txt">FAQ 관리</span>
    </a>
  </nav>

  <div class="admin-sidenav__spacer"></div>

  <!-- ✅ 하단 고정 로그아웃 (박스/닉네임 제거) -->
  <div class="admin-sidenav__footer">
    <form action="/members/logout" method="post" style="margin:0;">
      <button type="submit" class="admin-nav__item admin-logoutbtn" style="width:100%;">
        <span class="admin-nav__ico" aria-hidden="true">
          <svg viewBox="0 0 24 24"><path d="M10.09 15.59L11.5 17l5-5-5-5-1.41 1.41L12.67 11H3v2h9.67l-2.58 2.59zM19 3H5c-1.1 0-2 .9-2 2v4h2V5h14v14H5v-4H3v4c0 1.1.9 2 2 2h14c1.1 0 2-.9 2-2V5c0-1.1-.9-2-2-2z"/></svg>
        </span>
        <span class="admin-nav__txt">로그아웃</span>
      </button>
    </form>
  </div>
</aside>
